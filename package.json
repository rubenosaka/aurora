{
  "name": "aurora",
  "version": "0.0.0",
  "private": true,
  "description": "Aurora desktop application",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "postinstall": "install-electron",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-strip-types --test --test-reporter=spec src/**/*.test.ts scripts/**/*.test.ts",
    "test:components": "vitest run",
    "test": "pnpm test:unit && pnpm test:components",
    "test:coverage": "node --experimental-strip-types --test --test-reporter=spec --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 --test-coverage-include=src/main/trusted-sender.ts --test-coverage-include=src/main/app-info-handler.ts --test-coverage-include=src/shared/app-info.ts --test-coverage-include=src/preload/aurora-api.ts --test-coverage-include=src/renderer/src/aurora-client.ts src/**/*.test.ts scripts/**/*.test.ts",
    "check:build": "node --experimental-strip-types scripts/check-build.ts",
    "package": "node --experimental-strip-types scripts/check-package.ts --require-icon && pnpm build && pnpm exec electron-builder --win --x64 --publish never",
    "check:package": "node --experimental-strip-types scripts/check-package.ts",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "10.0.1",
    "@lucide/vue": "1.56.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-router": "4.6.4",
    "vue-tsc": "3.3.13"
  }
}
